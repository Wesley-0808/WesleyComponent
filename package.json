{
  "name": "wesley-component-mono",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "dev": "pnpm -C packages/site dev",
    "build": "cross-env NODE_ENV=production tsx ./scripts/index.ts",
    "site:build": "pnpm -C packages/site build",
    "tsc": "tsc -b",
    "preview": "vite preview --port 15700",
    "lint:fix": "eslint --ext .vue,.js,.ts,.tsx ./packages/components --max-warnings 0 --fix --cache",
    "lint": "pnpm lint:tsc && eslint --ext .vue,.js,.ts,.tsx ./packages/components --max-warnings 0 --cache",
    "lint:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@vue/runtime-dom": "^3.5.22",
    "@vueuse/core": "^10.11.1",
    "@wesley/components": "workspace:^",
    "@wesley/hooks": "workspace:^",
    "@wesley/utils": "workspace:^",
    "@wesley/styles": "workspace:^",
    "core-js": "^3.46.0",
    "crypto-js": "^4.2.0",
    "execa": "^8.0.1",
    "fake-progress": "^1.0.4",
    "tdesign-vue-next": "^1.17.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/helper-module-imports": "^7.22.9",
    "@babel/plugin-transform-modules-commonjs": "^7.22.5",
    "@babel/plugin-transform-object-assign": "^7.22.5",
    "@babel/plugin-transform-runtime": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-url": "^7.0.0",
    "@types/eslint": "^9.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.5.1",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vue/babel-plugin-jsx": "^1.4.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "@vue/runtime-core": "^3.5.22",
    "@vue/runtime-dom": "3.3.9",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^8.7.1",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.1",
    "less": "^4.1.2",
    "prettier": "2.8.1",
    "rollup": "^2.79.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-esbuild": "^4.10.3",
    "rollup-plugin-ignore-import": "^1.3.2",
    "rollup-plugin-multi-input": "^1.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-static-import": "^0.1.1",
    "rollup-plugin-styles": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "stylelint": "~14.16.1",
    "stylelint-config-standard": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": " ^5.7.3",
    "vite-plugin-markdown": "^2.2.0",
    "vue-tsc": "^2.2.4"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx}": [
      "prettier --write --cache",
      "eslint --fix --cache"
    ],
    "**/*.{css,wxss,less}": [
      "stylelint"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
